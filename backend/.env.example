# Database URL (Defaults to SQLite for local development; switch to PostgreSQL in production)
DATABASE_URL=sqlite:///./sapps.db
# Example PostgreSQL:
# DATABASE_URL=postgresql://sapps_user:sapps_password@localhost:5432/sapps_db

# JWT Security
SECRET_KEY=sapps-super-secret-production-grade-key-2024-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment & CORS
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

